APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# APP_DEBUG must be false in production. Set APP_ENV=production and configure secrets outside source control.
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
# Local development defaults only; use a least-privilege dedicated database user in production.
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
BACKUP_DISK=backups
BACKUP_PATH=planora
BACKUP_ENCRYPTION_KEY=
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_AT=02:00
BACKUP_KEEP_DAILY_DAYS=7
BACKUP_KEEP_WEEKLY_WEEKS=4
BACKUP_KEEP_MONTHLY_MONTHS=6
BACKUP_MAX_ARCHIVE_BYTES=10737418240
QUEUE_CONNECTION=sync
# Local development only. Production must use redis (or another shared persistent queue) and run workers.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_REMEMBER_LIFETIME=43200
# Enable this when serving the application over HTTPS in production.
SESSION_SECURE_COOKIE=false
# Local HTTP only. Production sets APP_ENV=production; secure cookies are enabled automatically.
TRUSTED_PROXIES=
# Comma-separated, operator-provided proxy IP addresses/CIDRs. Leave empty when not behind a trusted proxy.
PASSWORD_BREACH_CHECK_ENABLED=true
AUTH_ENUMERATION_MIN_RESPONSE_MS=250
ADMIN_MFA_LOGIN_CHALLENGE_MINUTES=5
ADMIN_MFA_ENROLLMENT_CHALLENGE_MINUTES=10
ADMIN_MFA_ENROLLMENT_MINUTES=10
ADMIN_MFA_STEP_UP_GRANT_SECONDS=60
ADMIN_MFA_CHALLENGE_MAX_ATTEMPTS=5
ADMIN_MFA_CHALLENGE_WINDOW_MINUTES=5
ADMIN_MFA_CHALLENGE_LOCKOUT_MINUTES=5
ADMIN_MFA_ACCOUNT_MAX_ATTEMPTS=15
ADMIN_MFA_ACCOUNT_WINDOW_MINUTES=15
ADMIN_MFA_ACCOUNT_LOCKOUT_MINUTES=15
ADMIN_MFA_LOGIN_IP_ATTEMPTS_PER_MINUTE=10
ADMIN_MFA_ENROLLMENT_IP_ATTEMPTS_PER_MINUTE=5
ADMIN_MFA_STEP_UP_IP_ATTEMPTS_PER_MINUTE=5

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
